Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # This fallback protects the repository if Apache is pointed at the project root.
    RewriteRule (^|/)(?:\.env(?:\..*)?|\.git(?:/|$)|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml|vite\.config\.js|artisan)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:app|bootstrap|config|database|resources|routes|storage|vendor)(?:/|$) - [F,L,NC]

    RewriteCond %{REQUEST_URI} !^/public(?:/|$)
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>